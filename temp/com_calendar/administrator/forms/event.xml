<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details">
        <field
            name="id"
            type="hidden"
        />
        <field
            name="title"
            type="text"
            label="JGLOBAL_TITLE"
            required="true"
            size="40"
        />
        <field
            name="description"
            type="editor"
            label="JGLOBAL_DESCRIPTION"
            filter="safehtml"
            buttons="true"
        />
        <field
            name="location"
            type="text"
            label="COM_CALENDAR_FIELD_LOCATION"
            size="40"
        />
        <field
            name="start_date"
            type="calendar"
            label="COM_CALENDAR_FIELD_START_DATE"
            required="true"
            format="%Y-%m-%d %H:%M:%S"
            showtime="true"
            translateformat="false"
        />
        <field
            name="end_date"
            type="calendar"
            label="COM_CALENDAR_FIELD_END_DATE"
            format="%Y-%m-%d %H:%M:%S"
            showtime="true"
            translateformat="false"
        />
        <field
            name="all_day"
            type="list"
            label="COM_CALENDAR_FIELD_ALL_DAY"
            default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field
            name="color"
            type="color"
            control="hue"
            label="COM_CALENDAR_FIELD_COLOR"
            default="#3788d8"
        />
        <field
            name="category_id"
            type="sql"
            label="COM_CALENDAR_FIELD_CATEGORY"
            query="SELECT id, title FROM #__calendar_categories WHERE state = 1 ORDER BY ordering, title"
            key_field="id"
            value_field="title"
            default="0"
        >
            <option value="0">COM_CALENDAR_NO_CATEGORY</option>
        </field>
        <field
            name="recurrence_type"
            type="list"
            label="COM_CALENDAR_FIELD_RECURRENCE"
            default="none"
        >
            <option value="none">COM_CALENDAR_RECURRENCE_NONE</option>
            <option value="daily">COM_CALENDAR_RECURRENCE_DAILY</option>
            <option value="weekly">COM_CALENDAR_RECURRENCE_WEEKLY</option>
            <option value="monthly">COM_CALENDAR_RECURRENCE_MONTHLY</option>
            <option value="yearly">COM_CALENDAR_RECURRENCE_YEARLY</option>
        </field>
        <field
            name="recurrence_interval"
            type="number"
            label="COM_CALENDAR_FIELD_RECURRENCE_INTERVAL"
            default="1"
            min="1"
            max="365"
        />
        <field
            name="recurrence_end"
            type="calendar"
            label="COM_CALENDAR_FIELD_RECURRENCE_END"
            format="%Y-%m-%d"
            showtime="false"
            translateformat="false"
        />
        <field
            name="skip_holidays"
            type="list"
            label="COM_CALENDAR_FIELD_SKIP_HOLIDAYS"
            description="COM_CALENDAR_FIELD_SKIP_HOLIDAYS_DESC"
            default="0"
            showon="recurrence_type!:none"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field
            name="holiday_country"
            type="text"
            label="COM_CALENDAR_FIELD_HOLIDAY_COUNTRY"
            description="COM_CALENDAR_FIELD_HOLIDAY_COUNTRY_DESC"
            maxlength="2"
            default="DE"
            showon="recurrence_type!:none[AND]skip_holidays:1"
        />
        <field
            name="holiday_subdivision"
            type="text"
            label="COM_CALENDAR_FIELD_HOLIDAY_SUBDIVISION"
            description="COM_CALENDAR_FIELD_HOLIDAY_SUBDIVISION_DESC"
            maxlength="6"
            showon="recurrence_type!:none[AND]skip_holidays:1"
        />
        <field
            name="exception_dates"
            type="text"
            label="COM_CALENDAR_FIELD_EXCEPTION_DATES"
            description="COM_CALENDAR_FIELD_EXCEPTION_DATES_DESC"
            showon="recurrence_type!:none"
        />
        <field
            name="state"
            type="list"
            label="JSTATUS"
            default="1"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field
            name="access"
            type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            default="1"
        />
        <field
            name="created"
            type="hidden"
        />
        <field
            name="created_by"
            type="hidden"
        />
        <field
            name="modified"
            type="hidden"
        />
        <field
            name="modified_by"
            type="hidden"
        />
    </fieldset>
</form>
