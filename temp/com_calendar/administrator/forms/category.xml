<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details">
        <field
            name="id"
            type="hidden"
        />
        <field
            name="title"
            type="text"
            label="JGLOBAL_TITLE"
            required="true"
            size="40"
        />
        <field
            name="description"
            type="textarea"
            label="JGLOBAL_DESCRIPTION"
            rows="4"
        />
        <field
            name="color"
            type="color"
            control="hue"
            label="COM_CALENDAR_FIELD_COLOR"
            default="#3788d8"
        />
        <field
            name="state"
            type="list"
            label="JSTATUS"
            default="1"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
        <field
            name="ordering"
            type="number"
            label="JFIELD_ORDERING_LABEL"
            default="0"
            min="0"
        />
        <field
            name="access"
            type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            default="1"
        />
        <field
            name="created_by"
            type="hidden"
        />
        <field
            name="created"
            type="hidden"
        />
    </fieldset>
</form>
