<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_JWCALENDAR</name>
    <author>huberlabs.ch</author>
    <creationDate>2026-03-25</creationDate>
    <copyright>(C) 2026 huberlabs.ch</copyright>
    <authorEmail>support@huberlabs.ch</authorEmail>
    <authorUrl>https://www.eiwtestzone.ch/huberlabs-extensions/</authorUrl>
    <license>GNU General Public License version 2 or later</license>
    <version>1.9.1</version>
    <description>MOD_JWCALENDAR_DESC</description>
    <namespace path="src">Jewe\Module\JwCalendar</namespace>

    <files>
        <filename module="mod_jwcalendar">mod_jwcalendar.php</filename>
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages folder="language">
        <language tag="de-DE">de-DE/mod_jwcalendar.ini</language>
        <language tag="de-DE">de-DE/mod_jwcalendar.sys.ini</language>
        <language tag="en-GB">en-GB/mod_jwcalendar.ini</language>
        <language tag="en-GB">en-GB/mod_jwcalendar.sys.ini</language>
        <language tag="ka-GE">ka-GE/mod_jwcalendar.ini</language>
        <language tag="it-IT">it-IT/mod_jwcalendar.ini</language>
        <language tag="es-ES">es-ES/mod_jwcalendar.ini</language>
        <language tag="fr-FR">fr-FR/mod_jwcalendar.ini</language>
        <language tag="pt-PT">pt-PT/mod_jwcalendar.ini</language>
        <language tag="ru-RU">ru-RU/mod_jwcalendar.ini</language>
        <language tag="ar-AA">ar-AA/mod_jwcalendar.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="default_view"
                    type="list"
                    label="MOD_JWCALENDAR_DEFAULT_VIEW"
                    default="dayGridMonth"
                >
                    <option value="dayGridMonth">MOD_JWCALENDAR_VIEW_MONTH</option>
                    <option value="timeGridWeek">MOD_JWCALENDAR_VIEW_WEEK</option>
                    <option value="timeGridDay">MOD_JWCALENDAR_VIEW_DAY</option>
                    <option value="listMonth">MOD_JWCALENDAR_VIEW_LIST</option>
                </field>
                <field
                    name="start_date_mode"
                    type="list"
                    label="MOD_JWCALENDAR_START_DATE_MODE"
                    description="MOD_JWCALENDAR_START_DATE_MODE_DESC"
                    default="today"
                >
                    <option value="today">MOD_JWCALENDAR_START_MODE_TODAY</option>
                    <option value="next_event_if_empty">MOD_JWCALENDAR_START_MODE_IF_EMPTY</option>
                    <option value="next_event">MOD_JWCALENDAR_START_MODE_NEXT</option>
                </field>
                <field
                    name="show_sidebar"
                    type="list"
                    label="MOD_JWCALENDAR_SHOW_SIDEBAR"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="allow_frontend_edit"
                    type="list"
                    label="MOD_JWCALENDAR_ALLOW_EDIT"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="calendar_height"
                    type="text"
                    label="MOD_JWCALENDAR_HEIGHT"
                    default="auto"
                />
                <field
                    name="show_week_numbers"
                    type="list"
                    label="MOD_JWCALENDAR_WEEK_NUMBERS"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="first_day"
                    type="list"
                    label="MOD_JWCALENDAR_FIRST_DAY"
                    default="1"
                >
                    <option value="0">MOD_JWCALENDAR_SUNDAY</option>
                    <option value="1">MOD_JWCALENDAR_MONDAY</option>
                </field>
                <field
                    name="category_filter"
                    type="sql"
                    label="MOD_JWCALENDAR_CATEGORY_FILTER"
                    query="SELECT id, title FROM #__calendar_categories WHERE state = 1 ORDER BY ordering, title"
                    key_field="id"
                    value_field="title"
                    multiple="true"
                    default=""
                >
                    <option value="">MOD_JWCALENDAR_ALL_CATEGORIES</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" name="HL Calendar Updates">https://raw.githubusercontent.com/IvanosHuberius/HL-Calendar/main/update_server/jwcalendar_update.xml</server>
    </updateservers>
</extension>
