<?xml version="1.0" encoding="utf-8"?>
<!--
    HL Calendar Update Server
    Public location (referenced by the extension manifests):
        https://raw.githubusercontent.com/IvanosHuberius/HL-Calendar/main/update_server/jwcalendar_update.xml

    TRANSITION NOTE (1.7.2 -> 1.8.0):
    Existing 1.7.2 installs still query the OLD eiwtestzone update URL. To deliver the
    1.8.0 update to them once, also upload THIS file to:
        https://www.eiwtestzone.ch/huberlabs-extensions/updates/jwcalendar_update.xml
    After users update to 1.8.0 their manifest points here (GitHub) and eiwtestzone can be retired.

    On each new release: bump <version> and the download URL to the matching GitHub release asset.
-->
<updates>
    <update>
        <name>HL Calendar Package</name>
        <description>HL Kalender - Google Calendar-ähnlicher Kalender für Joomla</description>
        <element>pkg_jwcalendar</element>
        <type>package</type>
        <client>site</client>
        <version>1.8.0</version>
        <downloads>
            <downloadurl type="full" format="zip">https://github.com/IvanosHuberius/HL-Calendar/releases/download/v1.8.0/pkg_jwcalendar_v1.8.0.zip</downloadurl>
        </downloads>
        <tags>
            <tag>stable</tag>
        </tags>
        <maintainer>huberlabs.ch</maintainer>
        <maintainerurl>https://www.eiwtestzone.ch/huberlabs-extensions/</maintainerurl>
        <targetplatform name="joomla" version="(5|6)\.[0-9]" />
        <php_minimum>8.1</php_minimum>
    </update>
</updates>
